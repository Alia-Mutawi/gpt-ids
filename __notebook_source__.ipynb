def plot_metrics_heatmap(y_true, y_pred, model_name, phase_name):
    # استخراج مقاييس الأداء وتجاهل القسمة على صفر
    report = classification_report(y_true, y_pred, target_names=le.classes_, output_dict=True, zero_division=0)
    df_report = pd.DataFrame(report)[le.classes_].T[['precision', 'recall', 'f1-score']]
    
    # رسم الخريطة الحرارية
    plt.figure(figsize=(7, 4))
    sns.heatmap(df_report, annot=True, cmap='Blues', vmin=0, vmax=1, fmt='.2f', linewidths=0.5)
    plt.title(f'{phase_name} Metrics: {model_name}', pad=15, fontsize=12, fontweight='bold')
    plt.ylabel('Attack Classes')
    plt.xlabel('Evaluation Metrics')
    plt.tight_layout()
    plt.show()

