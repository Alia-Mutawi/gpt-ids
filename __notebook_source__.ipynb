def detailed_metrics(y_true, y_pred, class_names):
    report = classification_report(
        y_true, y_pred,
        labels=np.arange(len(class_names)),
        target_names=class_names,
        output_dict=True,
        zero_division=0
    )
    cm = confusion_matrix(y_true, y_pred, labels=np.arange(len(class_names)))
    false_positives = cm.sum(axis=0) - np.diag(cm)

    rows = []
    for i, cls in enumerate(class_names):
        rows.append({
            'class': cls,
            'precision': report[cls]['precision'],
            'recall': report[cls]['recall'],
            'f1': report[cls]['f1-score'],
            'support': int(report[cls]['support']),
            'false_positives': int(false_positives[i])
        })

    summary = {
        'accuracy': accuracy_score(y_true, y_pred),
        'macro_f1': f1_score(y_true, y_pred, labels=np.arange(len(class_names)), average='macro', zero_division=0),
        'weighted_f1': f1_score(y_true, y_pred, average='weighted', zero_division=0),
        'macro_precision': precision_score(y_true, y_pred, labels=np.arange(len(class_names)), average='macro', zero_division=0),
        'macro_recall': recall_score(y_true, y_pred, labels=np.arange(len(class_names)), average='macro', zero_division=0),
        'balanced_accuracy': balanced_accuracy_score(y_true, y_pred)
    }
    return pd.DataFrame(rows), pd.DataFrame([summary]), cm

all_results = []
for name, pred in [
    ('Random Forest', pred_rf_test),
    ('XGBoost', pred_xgb_test),
    ('Stacking', pred_stack_test)
]:
    per_class, summary, cm = detailed_metrics(y_test, pred, le.classes_)
    per_class['model'] = name
    summary['model'] = name
    all_results.append((name, per_class, summary, cm))
    print(f'\n=== {name} ===')
    print(per_class)
    print(summary)

classwise_table = pd.concat([x[1] for x in all_results], ignore_index=True)
overall_table = pd.concat([x[2] for x in all_results], ignore_index=True)
classwise_table.to_csv(os.path.join(ARTIFACT_DIR, 'test_classwise_metrics.csv'), index=False)
overall_table.to_csv(os.path.join(ARTIFACT_DIR, 'test_overall_metrics.csv'), index=False)


