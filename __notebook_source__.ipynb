def normalize_columns(df):
    df = df.copy()
    df.columns = (
        df.columns.astype(str)
        .str.strip()
        .str.replace(' ', '_', regex=False)
        .str.lower()
    )
    return df


def map_label(label):
    label = str(label).strip().lower()
    if any(x in label for x in ['benign', 'normal', 'legitimate']):
        return 'BENIGN'
    if any(x in label for x in ['bot', 'botnet']):
        return 'Bot'
    if any(x in label for x in ['slowloris', 'slow_loris', 'slowhttp', 'slow http']):
        return 'DoS_Slowloris'
    return None


def prepare_raw_capture(df, dataset_name, capture_id, label_col='label'):
    df = normalize_columns(df)
    if label_col not in df.columns:
        # Defensive search for a label-like column.
        candidates = [c for c in df.columns if c in ['label', 'attack_cat', 'target']]
        if not candidates:
            raise ValueError(f'No label column found in {capture_id}. Available columns: {df.columns[:10].tolist()}')
        label_col = candidates[0]

    df['unified_label'] = df[label_col].map(map_label)
    df = df[df['unified_label'].notna()].copy()

    # Metadata are identifiers for the split only; they are never model features.
    df['dataset'] = dataset_name
    df['capture_id'] = capture_id
    return df.reset_index(drop=True)





