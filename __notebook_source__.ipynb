def detect_xgb_device():
    try:
        probe_X = np.array([[0.0], [1.0], [2.0], [3.0]])
        probe_y = np.array([0, 1, 0, 1])
        probe = xgb.XGBClassifier(
            n_estimators=1, max_depth=2,
            tree_method='hist', device='cuda',
            eval_metric='logloss', random_state=RANDOM_STATE
        )
        probe.fit(probe_X, probe_y)
        return 'cuda'
    except Exception as e:
        print('CUDA probe failed; falling back to CPU:', type(e).__name__)
        return 'cpu'

