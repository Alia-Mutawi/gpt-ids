def stack_predict(base_rf, base_xgb, meta, X):
    meta_X = np.hstack([
        base_rf.predict_proba(X),
        base_xgb.predict_proba(X)
    ])
    return meta.predict(meta_X), meta.predict_proba(meta_X)

