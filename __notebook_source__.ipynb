from sklearn.model_selection import StratifiedKFold

def generate_oof_and_full_models_stratified(Xdata, ydata, rf_template, xgb_template, n_splits=5):
    skf = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=RANDOM_STATE)
    
    oof_rf = np.zeros((len(ydata), 3), dtype=float)
    oof_xgb = np.zeros((len(ydata), 3), dtype=float)

    fold_records = []
    for fold, (tr_idx, va_idx) in enumerate(skf.split(Xdata, ydata), start=1):
        print(f'OOF fold {fold}/{n_splits} | Train samples: {len(tr_idx)} | Validation samples: {len(va_idx)}')
        
        rf_fold, rf_classes = fit_base(rf_template, Xdata[tr_idx], ydata[tr_idx], is_xgb=False)
        xgb_fold, xgb_classes = fit_base(xgb_template, Xdata[tr_idx], ydata[tr_idx], is_xgb=True)
        
        rf_preds = rf_fold.predict_proba(Xdata[va_idx])
        for i, class_lbl in enumerate(rf_classes):
            oof_rf[va_idx, int(class_lbl)] = rf_preds[:, i]

        xgb_preds = xgb_fold.predict_proba(Xdata[va_idx])
        for i, class_lbl in enumerate(xgb_classes):
            oof_xgb[va_idx, int(class_lbl)] = xgb_preds[:, i]
            
        fold_records.append({'fold': fold})

    rf_full, _ = fit_base(rf_template, Xdata, ydata, is_xgb=False)
    xgb_full, _ = fit_base(xgb_template, Xdata, ydata, is_xgb=True)
    
    return oof_rf, oof_xgb, rf_full, xgb_full, pd.DataFrame(fold_records)

