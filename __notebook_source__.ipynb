def stratified_sample(X, y, max_rows=150_000, random_state=42):
    X_df = pd.DataFrame(X)
    y_arr = np.asarray(y)
    if len(y_arr) <= max_rows:
        return X_df.values, y_arr

    rng = np.random.RandomState(random_state)
    parts = []
    for cls in np.unique(y_arr):
        idx = np.where(y_arr == cls)[0]
        take = max(1, int(round(max_rows * len(idx) / len(y_arr))))
        take = min(take, len(idx))
        parts.extend(rng.choice(idx, size=take, replace=False).tolist())
    parts = np.asarray(parts)
    if len(parts) > max_rows:
        parts = rng.choice(parts, size=max_rows, replace=False)
    rng.shuffle(parts)
    return X_df.iloc[parts].values, y_arr[parts]

