def plot_conf_matrix(y_true, y_pred, model_name):
    cm = confusion_matrix(y_true, y_pred)
    plt.figure(figsize=(6, 5))
    sns.heatmap(cm, annot=True, fmt='d', cmap='Oranges', xticklabels=le.classes_, yticklabels=le.classes_)
    plt.title(f'Confusion Matrix: {model_name}\n(Stratified Test Data)', pad=15, fontweight='bold')
    plt.ylabel('Actual Label (True)')
    plt.xlabel('Predicted Label (Model)')
    plt.tight_layout()
    plt.show()

