def benchmark_prediction(model_fn, X_bench, repeats=10):
    X_bench = X_bench[:min(len(X_bench), BENCHMARK_ROWS)]
    process = psutil.Process(os.getpid())
    model_fn(X_bench)
    times = []
    memory_before = process.memory_info().rss
    for _ in range(repeats):
        t0 = time.perf_counter()
        model_fn(X_bench)
        times.append(time.perf_counter() - t0)
    memory_after = process.memory_info().rss
    return {
        'rows_benchmarked': len(X_bench),
        'mean_batch_latency_ms': 1000 * float(np.mean(times)),
        'p95_batch_latency_ms': 1000 * float(np.percentile(times, 95)),
        'mean_per_sample_ms': 1000 * float(np.mean(times)) / len(X_bench),
        'approx_rss_delta_mb': max(0.0, (memory_after - memory_before) / (1024 ** 2))
    }

stack_bench = benchmark_prediction(lambda Xb: stack_predict(rf_base_train, xgb_base_train, meta_model, Xb)[0], X_test)
light_bench = benchmark_prediction(lambda Xb: light_model.predict(Xb), light_test_scaled)

size_latency_table = pd.DataFrame([
    {
        'model': 'Full Stacking',
